{
  "name": "couponsriver-indexing-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Safe indexing automation worker for couponsriver.com: reads the live sitemap, detects new/changed URLs, stores state in SQLite, and submits eligible URLs to Bing IndexNow.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "check": "tsc --noEmit",
    "run:once": "tsx src/index.ts --once"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4"
  }
}
