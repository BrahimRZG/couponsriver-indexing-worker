TARGET_SITE=https://couponsriver.com

# IndexNow / Bing
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=https://couponsriver.com/indexnow-key.txt

# Worker behavior
MAX_URLS_PER_RUN=500
CONCURRENCY=5
REQUEST_TIMEOUT_MS=15000
USER_AGENT=CouponsRiverIndexingWorker/1.0 (+https://couponsriver.com)

# Storage
DATABASE_PATH=./data/indexing.sqlite

# Mode
DRY_RUN=true

# Optional: Bing Webmaster API (not the primary path; IndexNow is preferred)
BING_WEBMASTER_API_KEY=
